# comments and corrections made by Michael Simons

start = article
article = element article {head, body} # deleted mixed here and changed "|" to "," because I think the "article" tag should expect a head element, then a body element, with no floating text in-between. 

head = element head {titleLine, headLine+} # added "+" to headLine because there can be more than 1
    titleLine = element titleLine {mixed{(newspaper, date, num?, series)}} # (2 corrections/comments) added element "series" to mixed ... # moved "num?" into mixed
    headLine = element headLine {n, mixed{(newspaper | shift | money)*}} # created element "headLine"
    shift = element shift {dur, text} # created element "shift"
    dur = attribute dur{text} # created attribute "dur"
    money = element money {unit, amount, text} # created element "money"
    unit = attribute unit {"USD" | "Euro" | "Peso" | text} # created attribute "unit" with a few preset units including the one used in the provided XML
    newspaper = element newspaper {text} # changed argument from "empty" to "text" to allow text in element
    date = element date {when, text}
    when = attribute when {xsd:date | xsd:gYearMonth | xsd:gYear} # created attribute "when"
    num = element num {amount, text}
    amount = attribute amount {xsd:double} # replaced question marks with "double" - just Google it if you don't remember what xsd data type you need! And I chose double instead of float because that's just what we did over in CompSci :)
    series = element series {text}
    n = attribute n {xsd:integer} # replaced question marks with xsd data type "integer"

body = element body {p+} #added "+" to allow for multiple paragraphs
    p = element p {mixed{(company | address | description)*}} # added "mixed" to the already correct grouping of elements, and then removed "text" since mixed allows for text throughout 
    company = element company {text}
    address = element address {type, text}
    type = attribute type {"exact" | "general"} # changed "," to "|" to allow for a choice to be made between the two values (whereas the comma implies that both values are expected with Relax NG/oXygen doesn't like
    description = element description {mixed{(company|address)*}}


